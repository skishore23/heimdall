# Environment configuration for Bifröst Gateway
#
# AUTHENTICATION FLOW:
#   Client → Bifröst → Upstream LLM
#   (none)    (below)   (uses keys below)
#
# Client doesn't need API key - Bifröst is a trusted proxy
# Authentication: x-policy-id header + tenant_id
# Bifröst uses UPSTREAM_API_KEY (or OPENAI_API_KEY) to connect to upstream

# Server configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# CORS configuration
CORS_ORIGINS=["*"]

# Redis configuration
REDIS_URL=redis://localhost:6379

# Policy configuration
DEFAULT_POLICY_ID=enterprise_default_v1
POLICIES_DIR=policies

# Provider API keys (default OpenAI mode)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Upstream LLM provider (proxy mode)
# Use these to proxy to any OpenAI-compatible endpoint
# Examples:
#   AWS Bedrock: https://bedrock-runtime.us-east-1.amazonaws.com/v1
#   Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment
#   Ollama: http://localhost:11434/v1
#   vLLM: http://your-server:8000/v1
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# GCP configuration (for production)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
KMS_KEY_NAME=projects/your-project/locations/us-central1/keyRings/guardrails-keyring/cryptoKeys/guardrails-policy-key

# Performance settings
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=45.0
CONNECT_TIMEOUT=0.4

# Guard settings
GUARD_TIMEOUT=0.2
STREAMING_WINDOW_SIZE=200
